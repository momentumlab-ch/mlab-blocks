{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mlab-blocks/anfrage-band",
	"title": "Anfrage-Band",
	"category": "mlab-blocks",
	"icon": "megaphone",
	"description": "Farbiges Band mit Titel, Text, Anfrage-Knopf und Schritten oder Links.",
	"textdomain": "mlab-blocks",
	"attributes": {
		"title": {
			"type": "string",
			"default": "In drei Schritten zum Fest"
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"button_text": {
			"type": "string",
			"default": "Anfrage senden"
		},
		"button_angebot": {
			"type": "string",
			"default": ""
		},
		"button_link": {
			"type": "string",
			"default": ""
		},
		"side": {
			"type": "string",
			"default": "schritte"
		},
		"steps": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		},
		"links": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"supports": {
		"html": false,
		"reusable": true
	},
	"editorScript": "mlab-blocks-editor",
	"editorStyle": "mlab-blocks-editor",
	"render": "file:./render.php",
	"mlab": {
		"fields": [
			{
				"key": "title",
				"label": "Titel",
				"type": "text",
				"default": "In drei Schritten zum Fest"
			},
			{
				"key": "text",
				"label": "Text",
				"type": "textarea"
			},
			{
				"key": "button_text",
				"label": "Knopf: Text",
				"type": "text",
				"default": "Anfrage senden"
			},
			{
				"key": "button_angebot",
				"label": "Knopf: führt zur Anfrage mit",
				"type": "angebot"
			},
			{
				"key": "button_link",
				"label": "Knopf: eigener Link (statt Anfrage)",
				"type": "url"
			},
			{
				"key": "side",
				"label": "Rechts daneben",
				"type": "select",
				"default": "schritte",
				"options": [
					[
						"schritte",
						"Schritte"
					],
					[
						"links",
						"Links"
					],
					[
						"nichts",
						"Nichts"
					]
				]
			},
			{
				"key": "steps",
				"label": "Schritte",
				"type": "repeater",
				"add": "Schritt hinzufügen",
				"fields": [
					{
						"key": "title",
						"label": "Titel",
						"type": "text"
					},
					{
						"key": "text",
						"label": "Text",
						"type": "text"
					}
				]
			},
			{
				"key": "links",
				"label": "Links",
				"type": "repeater",
				"add": "Link hinzufügen",
				"fields": [
					{
						"key": "text",
						"label": "Text",
						"type": "text"
					},
					{
						"key": "url",
						"label": "Link",
						"type": "url"
					}
				]
			}
		],
		"container": false,
		"allowed": null,
		"innerLabel": "",
		"preview": "render"
	}
}