{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mlab-blocks/angebotskarten",
	"title": "Angebotskarten",
	"category": "mlab-blocks",
	"icon": "id-alt",
	"description": "Karten mit Bild, Text, Preisen und Knopf (wie bei Erlebnisse).",
	"textdomain": "mlab-blocks",
	"attributes": {
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		}
	},
	"supports": {
		"html": false,
		"reusable": true
	},
	"editorScript": "mlab-blocks-editor",
	"editorStyle": "mlab-blocks-editor",
	"render": "file:./render.php",
	"mlab": {
		"fields": [
			{
				"key": "items",
				"label": "Karten",
				"type": "repeater",
				"add": "Karte hinzufügen",
				"fields": [
					{
						"key": "title",
						"label": "Titel",
						"type": "text"
					},
					{
						"key": "title_link",
						"label": "Titel verlinkt auf",
						"type": "url"
					},
					{
						"key": "text",
						"label": "Text",
						"type": "textarea"
					},
					{
						"key": "prices",
						"label": "Preise",
						"type": "textarea",
						"help": "Pro Zeile: Bezeichnung | Preis, z. B. «pro Person | CHF 50.–»."
					},
					{
						"key": "image",
						"label": "Bild",
						"type": "image"
					},
					{
						"key": "preset",
						"label": "oder Bild aus dem Design",
						"type": "preset"
					},
					{
						"key": "button_text",
						"label": "Knopf: Text",
						"type": "text"
					},
					{
						"key": "button_angebot",
						"label": "Knopf: führt zur Anfrage mit",
						"type": "angebot"
					},
					{
						"key": "more_text",
						"label": "Zweiter Knopf: Text (z. B. «Mehr erfahren»)",
						"type": "text"
					},
					{
						"key": "more_link",
						"label": "Zweiter Knopf: Link",
						"type": "url"
					}
				]
			}
		],
		"container": false,
		"allowed": null,
		"innerLabel": "",
		"preview": "render"
	}
}