{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mlab-blocks/knoepfe",
	"title": "Knöpfe",
	"category": "mlab-blocks",
	"icon": "button",
	"description": "Ein oder zwei Knöpfe nebeneinander.",
	"textdomain": "mlab-blocks",
	"attributes": {
		"button_text": {
			"type": "string",
			"default": ""
		},
		"button_angebot": {
			"type": "string",
			"default": ""
		},
		"button_link": {
			"type": "string",
			"default": ""
		},
		"button2_text": {
			"type": "string",
			"default": ""
		},
		"button2_link": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"reusable": true
	},
	"editorScript": "mlab-blocks-editor",
	"editorStyle": "mlab-blocks-editor",
	"render": "file:./render.php",
	"mlab": {
		"fields": [
			{
				"key": "button_text",
				"label": "Knopf: Text",
				"type": "text"
			},
			{
				"key": "button_angebot",
				"label": "Knopf: führt zur Anfrage mit",
				"type": "angebot",
				"help": "Wählt im Anfrageformular das Angebot vor."
			},
			{
				"key": "button_link",
				"label": "Knopf: eigener Link (statt Anfrage)",
				"type": "url"
			},
			{
				"key": "button2_text",
				"label": "Zweiter Knopf: Text",
				"type": "text"
			},
			{
				"key": "button2_link",
				"label": "Zweiter Knopf: Link",
				"type": "url"
			}
		],
		"container": false,
		"allowed": null,
		"innerLabel": "",
		"preview": "render"
	}
}