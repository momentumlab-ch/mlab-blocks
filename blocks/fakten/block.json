{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "mlab-blocks/fakten",
	"title": "Fakten",
	"category": "mlab-blocks",
	"icon": "editor-ul",
	"description": "Kurze Fakten als Kästchen, z. B. Preis, Dauer, Personen.",
	"textdomain": "mlab-blocks",
	"attributes": {
		"items": {
			"type": "array",
			"default": [],
			"items": {
				"type": "object"
			}
		},
		"style": {
			"type": "string",
			"default": "kaestchen"
		}
	},
	"supports": {
		"html": false,
		"reusable": true
	},
	"editorScript": "mlab-blocks-editor",
	"editorStyle": "mlab-blocks-editor",
	"render": "file:./render.php",
	"mlab": {
		"fields": [
			{
				"key": "items",
				"label": "Fakten",
				"type": "repeater",
				"add": "Fakt hinzufügen",
				"fields": [
					{
						"key": "bold",
						"label": "Gross (z. B. «CHF 95.–»)",
						"type": "text"
					},
					{
						"key": "text",
						"label": "Klein (z. B. «pro Person»)",
						"type": "text"
					}
				]
			},
			{
				"key": "style",
				"label": "Darstellung",
				"type": "select",
				"default": "kaestchen",
				"options": [
					[
						"kaestchen",
						"Kästchen"
					],
					[
						"farbig",
						"Farbige Kacheln (wie die Biere)"
					]
				]
			}
		],
		"container": false,
		"allowed": null,
		"innerLabel": "",
		"preview": "render"
	}
}